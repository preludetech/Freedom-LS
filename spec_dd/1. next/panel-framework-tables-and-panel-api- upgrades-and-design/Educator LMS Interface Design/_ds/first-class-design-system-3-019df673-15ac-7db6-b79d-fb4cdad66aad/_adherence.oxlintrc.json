      "--color-success",
      "--color-success-light",
      "--color-surface",
      "--color-text",
      "--color-warning",
      "--color-warning-light",
      "--dur",
      "--dur-fast",
      "--dur-slow",
      "--ease-in-out",
      "--ease-out",
      "--fg",
      "--fg-1",
      "--fg-2",
      "--fg-3",
      "--fg-4",
      "--font-body",
      "--font-heading",
      "--font-mono",
      "--fs-body",
      "--fs-body-lg",
      "--fs-body-sm",
      "--fs-caption",
      "--fs-display",
      "--fs-h1",
      "--fs-h2",
      "--fs-h3",
