# Values below are literal: no surrounding quotes, no trailing whitespace. Compose writes
# them into the container verbatim, so a quote character becomes part of the value.
# The "# secret" / "# config" markers document the line that follows; they are never part
# of a value and should never be copied into a deployment's own variable store.

# Database Configuration
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=your_secure_password_here
DB_HOST=db
DB_PORT=5432
# libpq sslmode. "disable" is correct for the shipped same-host Postgres container,
# which has no TLS listener (the code falls back to "prefer" if this var is unset,
# which also works here since it downgrades to plaintext when there's nothing to
# negotiate with). Set to "require" or "verify-full" only for external/managed
# databases. For the same-host setup, the control that actually matters is not
# publishing port 5432 to the host, not this setting.
DB_SSLMODE=disable
# Persistent connection lifetime in seconds. Recommended 60-300s; never unlimited, which
# lets connections accumulate without bound under load. CONN_HEALTH_CHECKS is on, so
# stale sockets left over after a `db` container restart are recycled rather than reused.
DB_CONN_MAX_AGE=60
SECRET_KEY=50charactersofsupersecret
# secret — required in production; settings_prod fails fast (ImproperlyConfigured)
# on boot if unset. Without it the code falls back to a hardcoded dev salt that
# silently weakens webhook-secret Fernet encryption.
WEBHOOK_ENCRYPTION_SALT=another50charactersofsupersecret

# Email Configuration
# Mail is queued by default and sent by the fls_run_worker process, so a slow mail
# host no longer holds a request open. Leave EMAIL_BACKEND unset to get that. Set it
# to django.core.mail.backends.smtp.EmailBackend only to go back to sending inside
# the request — a deployment that runs no worker must, or no mail is ever sent. To
# keep queueing but send through a provider's own backend, set EMAIL_UPSTREAM_BACKEND
# in your settings module instead of changing this.
# EMAIL_BACKEND=freedom_ls.deployment.mail.QueuedEmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_app_specific_password_here
DEFAULT_FROM_EMAIL=your_email@example.com
# seconds — socket timeout for each SMTP operation (default 10). Unset, smtplib
# waits forever, and a wedged mail host stalls the worker for every other task too.
EMAIL_TIMEOUT=10

HOST_DOMAIN=staging.freedomlearningsystem.org
# config — default "admin/"; change to a non-guessable path to reduce automated
# scanning noise against the admin login
DJANGO_ADMIN_URL=admin/

# HSTS rollout (see docs/deployment-security-checklist.md for staged values)
# config — default 3600
HSTS_SECONDS=3600
# config — default False
HSTS_INCLUDE_SUBDOMAINS=False
# config — default False
HSTS_PRELOAD=False


# If you are deploying with the docker compose file included here,
# then you'll want to store the postgres data somewhere persistent.

DB_DATA_PATH=~/.lms_postges_prod_data


# -----------------------------------------------------------------------------
# External services (PostHog / Sentry / Cloudflare R2)
#
# See spec_dd/3. done/2026-07-09_09:42_support-concrete-project-deployment-master-decomposed-into-specs/third-party-services.md
# for account setup. Each var below is marked secret (never commit a real
# value) or config (safe to set here / in CI).
# -----------------------------------------------------------------------------

# PostHog analytics — unset POSTHOG_API_KEY disables PostHog entirely
# public token — safe in client-side HTML; per-environment
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# config — region host, default https://us.i.posthog.com (override for EU)
POSTHOG_API_HOST=https://us.i.posthog.com
# config, optional — only needed for a reverse-proxied PostHog ingestion host
POSTHOG_UI_HOST=

# Sentry error tracking — unset SENTRY_DSN disables Sentry entirely
# secret
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# config — set this whenever SENTRY_DSN is set: the Sentry SDK otherwise
# silently tags every event "production", making staging indistinguishable.
SENTRY_ENVIRONMENT=staging
# config — default 0.1 (low sample rate for cost control)
SENTRY_TRACES_SAMPLE_RATE=0.1
# config — default False; True attaches learner PII + full request bodies to every event
SENTRY_SEND_DEFAULT_PII=False

# Cloudflare R2 (S3-compatible) media object storage
#
# Media is split across three buckets by sensitivity: one anonymously readable,
# one for course content, one for anything tied to an identified learner. Six
# name variables, four values, three real buckets — the names outnumber the
# buckets because two pairs of aliases share a bucket on purpose.
#
# Every variable below is optional. Each property resolves from its own
# AWS_S3_<PURPOSE>_<PROPERTY> variable first, then the shared variable, and an
# alias with no bucket name from either falls back to local FileSystemStorage.
# PURPOSE is one of PUBLIC, COURSE_MEDIA, USER_UPLOADS, GENERATED,
# CERTIFICATES or DEFAULT.

# Bucket names. Leave AWS_STORAGE_BUCKET_NAME unset in production: with no
# shared fallback, a misspelled per-bucket name drops that alias to local disk,
# which freedom_ls_deployment.E002 catches under `manage.py check --deploy`,
# instead of silently writing to the wrong bucket. Its siblings catch the other
# halves — freedom_ls_deployment.E001 an alias that fell through to the same
# bucket as AWS_S3_DEFAULT_BUCKET_NAME, and freedom_ls_deployment.E003 an alias
# that took the shared name below while a bucket of its own was named for
# default. Set the shared name anyway and E003 is what tells you which alias
# inherited it.
# config, optional — shared fallback for every alias that names no bucket of its own.
# This fleet leaves it blank on purpose, for the E002 reason above; a deployment outside
# the First Class fleet that wants one shared bucket for every alias should set it.
AWS_STORAGE_BUCKET_NAME=
# config — organisation logos and branding, anonymously readable
AWS_S3_PUBLIC_BUCKET_NAME=fls-prod-public
# config — learner certificates, same bucket as public branding
AWS_S3_CERTIFICATES_BUCKET_NAME=fls-prod-public
# config — course images, PDFs and video; private, no personal data
AWS_S3_COURSE_MEDIA_BUCKET_NAME=fls-prod-course-media
# config — cohort report PDFs, under the cohort_reports/ prefix
AWS_S3_GENERATED_BUCKET_NAME=fls-prod-user-data
# config — learner uploads, under the user_uploads/ prefix
AWS_S3_USER_UPLOADS_BUCKET_NAME=fls-prod-user-data
# config — no bucket is created behind this name. Nothing should ever write
# here, so a write that reaches it fails on the missing bucket and on the
# credentials rather than landing learner data somewhere unintended.
AWS_S3_DEFAULT_BUCKET_NAME=fls-prod-default

# Credentials. Two token scopes: one that reaches only the user-data bucket,
# and a shared one for everything else. Splitting them is what keeps a leaked
# course-media token away from learner reports and uploads.
# Each key id and its secret must be set together or left blank together. Set
# only one half and startup fails with ImproperlyConfigured naming the missing
# variable, rather than pairing your key with the shared secret and failing on
# the first write with SignatureDoesNotMatch.
# secret — shared scope: public, certificates and course media
AWS_S3_ACCESS_KEY_ID=
# secret
AWS_S3_SECRET_ACCESS_KEY=
# secret — user-data scope: cohort reports
AWS_S3_GENERATED_ACCESS_KEY_ID=
# secret
AWS_S3_GENERATED_SECRET_ACCESS_KEY=
# secret — user-data scope: learner uploads
AWS_S3_USER_UPLOADS_ACCESS_KEY_ID=
# secret
AWS_S3_USER_UPLOADS_SECRET_ACCESS_KEY=

# config — e.g. https://<account-id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
# config — default "auto" (R2's region convention)
AWS_S3_REGION_NAME=auto

# Public serving. Set the custom domain and QUERYSTRING_AUTH=false per alias,
# never through the shared form: the shared form reaches all five media
# aliases, including the two holding personal data.
# freedom_ls_deployment.E004 catches that under `manage.py check --deploy`,
# reporting every private alias left serving unsigned URLs.
# config, optional — CDN domain in front of the public bucket
AWS_S3_PUBLIC_CUSTOM_DOMAIN=
# config, optional — same domain; certificates share the public bucket
AWS_S3_CERTIFICATES_CUSTOM_DOMAIN=
# config — default True. False opts this alias into public serving, and is
# correct only for a bucket whose whole purpose is anonymous read.
AWS_S3_PUBLIC_QUERYSTRING_AUTH=false
# config — default True
AWS_S3_CERTIFICATES_QUERYSTRING_AUTH=false

# Shared defaults for the aliases that keep signed URLs: course_media,
# user_uploads and reports.
# config, optional — leave unset so private aliases serve signed URLs. This fleet leaves
# it blank on purpose, for that reason; a deployment outside the First Class fleet that
# fronts its private buckets with its own CDN domain should set it.
AWS_S3_CUSTOM_DOMAIN=
# config — default True (private, time-limited signed URLs)
AWS_QUERYSTRING_AUTH=True
# config — default 3600 (signed-URL lifetime in seconds)
AWS_QUERYSTRING_EXPIRE=3600
